# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
/ios/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage
__tests__/

# Environment files
.env
.env.local
# .env.debug is committed — contains no production IDs

# Encoded WebP catalog used by Android asset packs. Local — do not commit (~100 MB).
/catalog-packs/

# Copied into Android modules at build time from catalog-packs/.
android/app/src/main/assets/catalog/
android/app/src/debug/assets/catalog_debug/
android/assetpacks/thumbs/src/main/assets/**
android/assetpacks/full/src/main/assets/**
!android/assetpacks/thumbs/src/main/assets/.gitkeep
!android/assetpacks/full/src/main/assets/.gitkeep

