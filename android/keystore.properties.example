# Copy to android/keystore.properties and fill in your release keystore credentials.
# Never commit keystore.properties or release.jks to version control.
MYAPP_RELEASE_STORE_FILE=release.jks
MYAPP_RELEASE_KEY_ALIAS=your_key_alias
MYAPP_RELEASE_STORE_PASSWORD=your_store_password
MYAPP_RELEASE_KEY_PASSWORD=your_key_password
