# =============================================================================
# RELEASE BUILD ENVIRONMENT (.env)
# =============================================================================
# Copy this file to the project root as `.env` before building a release APK/AAB.
# Debug builds automatically use `.env.debug` (Google test ads only).
#
# Never commit `.env` — it is listed in .gitignore.
# =============================================================================

# Build profile
APP_ENV=production
ADMOB_BUILD_TYPE=release
ADMOB_USE_TEST_ADS=false

# Production AdMob IDs (https://apps.admob.com/)
# Android app ID is also injected natively by Gradle. iOS app ID is also in
# app.json (`react-native-google-mobile-ads.ios_app_id`) so Info.plist is set.
ADMOB_APP_ID=
ADMOB_BANNER_ID=
ADMOB_INTERSTITIAL_ID=
ADMOB_IOS_APP_ID=
ADMOB_IOS_BANNER_ID=
ADMOB_IOS_INTERSTITIAL_ID=

# Customer support address — shown on the Support screen (tappable mailto + selectable
# text) and interpolated into the About Us contact section.
SUPPORT_EMAIL=yasir.munir128@gmail.com

# Customer support phone number in full international format, e.g. +923001234567.
# Shown on the Support screen as selectable text plus a one-tap dialer button.
SUPPORT_PHONE=+923134473192
